# COPA source and reproducibility manifests must remain version controlled.
!.gitignore
!COPA/.gitignore
!COPA/pyproject.toml
!COPA/requirements.txt
!COPA/configs/experiment_a.yaml
!COPA/configs/experiment_b.yaml
!COPA/configs/experiment_c.yaml
!COPA/configs/smoke.yaml

# Source-only publication policy. Generated data, experiment manifests, and
# documentation other than the two repository READMEs stay local.
*.yaml
*.yml
*.json
*.jsonl
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.csv
*.parquet
*.zip
*.gz
*.pdf
*.log
*.md
!/README.md
!/COPA/README.md
/data/
/results/
/logs/
/checkpoints/
